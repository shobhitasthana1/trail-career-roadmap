# Copy this file to ".env" and fill in your real values locally.
# NEVER commit your real .env file, and never share real values in PRs or chat.

# Port the API server listens on.
PORT=5051

# MongoDB connection string (MongoDB Atlas).
# Replace the <placeholders> with your cluster's values.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
